# Multi-stage build for Spot Optimizer Frontend
# Stage 1: Builder - Build React application
FROM node:18-alpine AS builder

# Accept build arguments
ARG VITE_API_URL=http://localhost:8000
ARG VITE_WS_URL=ws://localhost:8000

# Set working directory
WORKDIR /app

# Copy package files (including lock file for deterministic builds)
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
# Configure npm for better network reliability
# Using npm install instead of npm ci to handle lock file version mismatches
# between local and Docker node/npm versions
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm install --network-timeout=100000

# Copy frontend source code and configs
COPY frontend/ ./

# Set environment variables for Vite build
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

# Disable ESLint during build (treating warnings as errors)
ENV DISABLE_ESLINT_PLUGIN=true

# Build production bundle
RUN npm run build

# Stage 2: Serve - Nginx to serve static files
FROM nginx:alpine

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder
COPY --from=builder /app/build /usr/share/nginx/html

# Create non-root user
RUN addgroup -g 1000 spotoptimizer && \
    adduser -D -u 1000 -G spotoptimizer spotoptimizer && \
    chown -R spotoptimizer:spotoptimizer /usr/share/nginx/html && \
    chown -R spotoptimizer:spotoptimizer /var/cache/nginx && \
    chown -R spotoptimizer:spotoptimizer /var/log/nginx && \
    chown -R spotoptimizer:spotoptimizer /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R spotoptimizer:spotoptimizer /var/run/nginx.pid

# Switch to non-root user
USER spotoptimizer

# Expose ports
EXPOSE 80
EXPOSE 443

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
